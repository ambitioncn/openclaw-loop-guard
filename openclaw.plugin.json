{
  "id": "loop-guard",
  "name": "Loop Guard",
  "description": "Detects repeated OpenClaw tool failures and blocks unproductive retry loops.",
  "contracts": {
    "agentToolResultMiddleware": [
      "openclaw",
      "codex"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "blockRepeatedCalls": {
        "type": "boolean",
        "default": false
      },
      "blockAfterPendingTimeout": {
        "type": "boolean",
        "default": true
      },
      "pendingTimeoutMs": {
        "type": "integer",
        "minimum": 0,
        "default": 180000
      },
      "driverModel": {
        "type": "string",
        "description": "Model acting as the primary reasoning driver, for example qwen-local/qwen36-uncensored-llamacpp."
      },
      "executorModel": {
        "type": "string",
        "description": "Higher-capability model recommended for tool execution escalation, for example openai/gpt-5.5 or anthropic/claude-sonnet."
      },
      "executorRuntime": {
        "type": "string",
        "default": "codex"
      },
      "handoffEnabled": {
        "type": "boolean",
        "default": false
      },
      "handoffOnSoftWarn": {
        "type": "boolean",
        "default": true
      },
      "handoffOnBlock": {
        "type": "boolean",
        "default": true
      },
      "handoffSessionPrefix": {
        "type": "string",
        "default": "loop-guard"
      },
      "softThreshold": {
        "type": "integer",
        "minimum": 1,
        "default": 2
      },
      "hardThreshold": {
        "type": "integer",
        "minimum": 1,
        "default": 3
      },
      "windowMs": {
        "type": "integer",
        "minimum": 1000,
        "default": 600000
      },
      "maxEntries": {
        "type": "integer",
        "minimum": 10,
        "default": 500
      },
      "statePath": {
        "type": "string"
      },
      "highRiskTools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "exec",
          "apply_patch",
          "write",
          "edit"
        ]
      },
      "softMessage": {
        "type": "string"
      },
      "hardMessage": {
        "type": "string"
      },
      "pendingMessage": {
        "type": "string"
      }
    }
  }
}
