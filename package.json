{
  "name": "openclaw-loop-guard",
  "version": "0.2.0",
  "description": "OpenClaw failover guard that detects local-model loops and terminal failures, then hands the original task to a cloud executor.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./loop": "./src/loop.js"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "runtimeExtensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.6",
      "minGatewayVersion": "2026.6.6"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/loop.js"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "tool",
    "loop-guard"
  ],
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2026.6.6"
  },
  "devDependencies": {}
}
